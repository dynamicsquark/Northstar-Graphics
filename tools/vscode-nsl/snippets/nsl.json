      "$0"
    ],
    "description": "NSL STAGE_DEF directive"
  },
  "Legacy shader directive": {
    "prefix": "shader",
    "body": [
      "#shader ${1|VERTEX,PIXEL,COMPUTE,GEOMETRY,HULL,DOMAIN|}",
