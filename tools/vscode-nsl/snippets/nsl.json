  "Skinned vertex shader skeleton": {
    "prefix": "nsl-vertex-skinned",
    "body": [
      "STAGE VERTEX",
      "",
      "INPUT_LAYOUT",
      "{",
      "    Get(VERTEX_POSITION)",
      "    Get(VERTEX_NORMAL)",
      "    Get(VERTEX_UV0)",
      "    Get(VERTEX_COLOR)",
      "    Get(VERTEX_BONE_INDICES)",
      "    Get(VERTEX_BONE_WEIGHTS)",
      "}",
      "",
      "OUTPUT_LAYOUT",
      "{",
      "    Add(CLIP_POSITION)",
      "    Add(WORLD_POSITION)",
      "    Add(WORLD_NORMAL)",
      "    Add(UV0)",
      "    Add(COLOR)",
      "}",
      "",
      "PROPERTY Transforms",
      "{",
      "    Buffer Matrices",
      "    {",
      "        Get(WORLD_MATRIX)",
      "        Get(NORMAL_MATRIX)",
      "        Get(VP_MATRIX)",
      "    }",
      "}",
      "",
      "PROPERTY Skeleton",
      "{",
      "    Buffer SkinInfo",
      "    {",
      "        Get(BONE_PALETTE_OFFSET)",
      "        Get(BONE_COUNT)",
      "    }",
      "    StructuredBuffer BonePalette",
      "    {",
      "        Get(GLOBAL_BONE_MATRIX)",
      "    }",
      "}",
      "",
      "SHADER",
      "{",
      "    STAGE_OUTPUT Main(STAGE_INPUT input)",
      "    {",
      "        STAGE_OUTPUT o;",
      "        UInt baseOff = Skeleton.SkinInfo.BONE_PALETTE_OFFSET;",
      "        UInt4 idx = input.VERTEX_BONE_INDICES;",
      "        Vec4 w = input.VERTEX_BONE_WEIGHTS;",
      "        Vec4 p = Vec4(input.VERTEX_POSITION, 1.0);",
      "        Vec4 b0 = Mul(Skeleton.BonePalette[baseOff + idx.x].GLOBAL_BONE_MATRIX, p);",
      "        Vec4 b1 = Mul(Skeleton.BonePalette[baseOff + idx.y].GLOBAL_BONE_MATRIX, p);",
      "        Vec4 b2 = Mul(Skeleton.BonePalette[baseOff + idx.z].GLOBAL_BONE_MATRIX, p);",
      "        Vec4 b3 = Mul(Skeleton.BonePalette[baseOff + idx.w].GLOBAL_BONE_MATRIX, p);",
      "        Vec3 localPos = b0.xyz * w.x + b1.xyz * w.y + b2.xyz * w.z + b3.xyz * w.w;",
      "        Vec4 worldPos = Mul(Transforms.Matrices.WORLD_MATRIX, Vec4(localPos, 1.0));",
      "        o.CLIP_POSITION = Mul(Transforms.Matrices.VP_MATRIX, worldPos);",
      "        o.WORLD_POSITION = worldPos.xyz;",
      "        o.WORLD_NORMAL = Normalize(Mul(Transforms.Matrices.NORMAL_MATRIX, input.VERTEX_NORMAL));",
      "        o.UV0 = input.VERTEX_UV0;",
      "        o.COLOR = input.VERTEX_COLOR;",
      "        return o;",
      "    }",
      "}"
    ],
    "description": "4-bone skeletal vertex shader using VERTEX_BONE_INDICES, VERTEX_BONE_WEIGHTS, and GLOBAL_BONE_MATRIX"
  },
  "NVG vertex-pulling vertex shader skeleton": {
    "prefix": "nsl-nvg-vertex",
    "body": [
      "STAGE VERTEX",
      "",
      "LIBRARY_DECLARATION",
      "{",
      "    Add(\"NorthstarLibrary/NVG/NVG.nsl\")",
      "}",
      "",
      "INPUT_LAYOUT",
      "{",
      "    Get(VERTEX_ID)",
      "    Get(INSTANCE_ID)",
      "}",
      "",
      "OUTPUT_LAYOUT",
      "{",
      "    Add(CLIP_POSITION)",
      "    Add(WORLD_POSITION)",
      "    Add(WORLD_NORMAL)",
      "    Add(UV0)",
      "    Add(COLOR)",
      "}",
      "",
      "PROPERTY ${1:Camera}",
      "{",
      "    Buffer ${2:Frame}",
      "    {",
      "        Get(VP_MATRIX)",
      "    }",
      "}",
      "",
      "SHADER",
      "{",
      "    STAGE_OUTPUT Main(STAGE_INPUT input)",
      "    {",
      "        STAGE_OUTPUT o;",
      "        NVGVisibleCluster vc  = NVGLoadVisibleCluster(input.INSTANCE_ID);",
      "        NVGClusterHeader  hdr = NVGDecodeClusterHeader(vc);",
      "        NVGDecodedVertex  v   = NVGDecodeClusterVertex(hdr, input.VERTEX_ID);",
      "        if (!v.isValid)",
      "        {",
      "            o.CLIP_POSITION  = NVGDegenerateClipPosition();",
      "            o.WORLD_POSITION = Vec3(0.0, 0.0, 0.0);",
      "            o.WORLD_NORMAL   = Vec3(0.0, 1.0, 0.0);",
      "            o.UV0            = Vec2(0.0, 0.0);",
      "            o.COLOR          = Vec4(0.0, 0.0, 0.0, 0.0);",
      "            return o;",
      "        }",
      "        Mat4 world = NVGGetObjectWorldMatrix(vc.objectSlot);",
      "        Vec3 worldPos = NVGTransformPosition(world, v.position);",
      "        Vec3 worldNrm = NVGTransformNormal(world, v.normal);",
      "        o.CLIP_POSITION  = Mul(${1:Camera}.${2:Frame}.VP_MATRIX, Vec4(worldPos, 1.0));",
      "        o.WORLD_POSITION = worldPos;",
      "        o.WORLD_NORMAL   = worldNrm;",
      "        o.UV0            = v.uv0;",
      "        o.COLOR          = (NVGGetDebugMode() != 0u) ? Vec4(NVGComputeDebugColor(vc, worldNrm), 1.0) : v.color;",
      "        return o;",
      "    }",
      "}"
    ],
    "description": "Northstar Virtual Geometry (NVG) vertex-pulling vertex shader using NorthstarLibrary/NVG/NVG.nsl"
  }
}
