    "description": "NSL legacy #shader stage directive (backward-compatible)"
  },
  "Library declaration block": {
    "prefix": "libdecl",
    "body": [
      "LIBRARY_DECLARATION",
      "{",
      "    Add(\"${1:NorthstarLibrary/NVSFiltering.nsl}\")",
      "}",
      "",
      "$0"
    ],
    "description": "NSL LIBRARY_DECLARATION import block"
  },
  "Library module skeleton": {
    "prefix": "nsl-library",
    "body": [
      "// =====================================================================",
      "//  ${1:library_name}.nsl — Northstar Shader Module Library",
      "// =====================================================================",
      "",
      "LIBRARY_DECLARATION",
      "{",
      "    $2",
      "}",
      "",
      "PROPERTY ${3:LibraryResources}",
      "{",
      "    $4",
      "}",
      "",
      "LIBRARY",
      "{",
      "    $0",
      "}"
    ],
    "description": "Full NSL LIBRARY module skeleton (no STAGE required)"
  },
  "Vertex shader skeleton": {
    "prefix": "nsl-vertex",
    "body": [
      "STAGE VERTEX",
      "",
      "INPUT_LAYOUT",
      "{",
      "    Get(VERTEX_POSITION)",
      "    Get(VERTEX_NORMAL)",
      "    Get(VERTEX_UV0)",
      "}",
      "",
      "OUTPUT_LAYOUT",
      "{",
      "    Add(CLIP_POSITION)",
      "    Add(WORLD_POSITION)",
      "    Add(WORLD_NORMAL)",
      "    Add(UV0)",
      "}",
      "",
      "PROPERTY ${1:Transforms}",
      "{",
      "    Buffer ${2:Matrices}",
      "    {",
      "        Get(MVP_MATRIX)",
      "        Get(WORLD_MATRIX)",
      "        Get(NORMAL_MATRIX)",
      "    }",
      "}",
      "",
      "SHADER",
      "{",
      "    Mat4 mvp = ${1:Transforms}.${2:Matrices}.MVP_MATRIX;",
      "    Mat4 world = ${1:Transforms}.${2:Matrices}.WORLD_MATRIX;",
      "    Mat3 normalMat = ${1:Transforms}.${2:Matrices}.NORMAL_MATRIX;",
      "",
      "    STAGE_OUTPUT Main(STAGE_INPUT input)",
      "    {",
      "        STAGE_OUTPUT o;",
      "        o.CLIP_POSITION = Mul(mvp, Vec4(input.VERTEX_POSITION, 1.0));",
      "        o.WORLD_POSITION = Mul(world, Vec4(input.VERTEX_POSITION, 1.0)).xyz;",
      "        o.WORLD_NORMAL = Normalize(Mul(normalMat, input.VERTEX_NORMAL));",
      "        o.UV0 = input.VERTEX_UV0;",
      "        return o;",
      "    }",
      "}"
    ],
    "description": "Full vertex shader (STAGE VERTEX, Property.Resource.Data access)"
  },
  "Pixel shader skeleton": {
    "prefix": "nsl-pixel",
    "body": [
      "STAGE PIXEL",
      "",
      "LIBRARY_DECLARATION",
      "{",
      "    Add(\"NorthstarLibrary/NVSFiltering.nsl\")",
      "}",
      "",
      "INPUT_LAYOUT",
      "{",
      "    Get(CLIP_POSITION)",
      "    Get(WORLD_POSITION)",
      "    Get(WORLD_NORMAL)",
      "    Get(UV0)",
      "}",
      "",
      "OUTPUT_LAYOUT",
      "{",
      "    Add(COLOR_TARGET0)",
      "}",
      "",
      "PROPERTY ${1:Material}",
      "{",
      "    Buffer ${2:Params}",
      "    {",
      "        Add(baseColor) : Vec4 = 1.0 1.0 1.0 1.0",
      "        Add(roughness) : Float = 0.5",
      "        Add(metallic)  : Float = 0.0",
      "    }",
      "",
      "    Texture2D ${3:Textures}",
      "    {",
      "        Add(BaseColorMap)",
      "    }",
      "",
      "    SamplerState ${4:Samplers}",
      "    {",
      "        Add(LINEAR_WRAP_SAMPLER)",
      "    }",
      "}",
      "",
      "PROPERTY ${5:Lighting}",
      "{",
      "    Buffer ${6:FrameData}",
      "    {",
      "        Get(CAMERA_POSITION)",
      "        Get(CAMERA_DIRECTION)",
      "        Get(LIGHT_COUNT)",
      "    }",
      "}",
      "",
      "SHADER",
      "{",
      "    Texture2D baseColorTex     = ${1:Material}.${3:Textures}.BaseColorMap;",
      "    SamplerState linearSampler = ${1:Material}.${4:Samplers}.LINEAR_WRAP_SAMPLER;",
      "",
      "    STAGE_OUTPUT Main(STAGE_INPUT input)",
      "    {",
      "        STAGE_OUTPUT o;",
      "        Vec4 col = ${1:Material}.${2:Params}.baseColor * Sample(baseColorTex, linearSampler, input.UV0);",
      "        o.COLOR_TARGET0 = col;",
      "        return o;",
      "    }",
      "}"
    ],
    "description": "Full lit pixel shader with NVS module import and material bindings"
  },
  "Compute shader skeleton": {
    "prefix": "nsl-compute",
    "body": [
      "STAGE COMPUTE",
      "",
      "PROPERTY ${1:Sim}",
      "{",
      "    Buffer ${2:Params}",
      "    {",
      "        Add(count) : UInt = 0",
      "    }",
      "    RWStructuredBuffer ${3:Particles}",
      "    {",
      "        Add(positions) : Vec4",
      "    }",
      "}",
      "",
      "SHADER",
      "{",
      "    UInt count = ${1:Sim}.${2:Params}.count;",
      "",
      "    [numthreads(${4:8}, ${5:8}, ${6:1})]",
      "    void Main(UInt3 id : DISPATCH_THREAD_ID)",
      "    {",
      "        if (id.x >= count) return;",
      "        ${1:Sim}.${3:Particles}[id.x].positions = ${1:Sim}.${3:Particles}[id.x].positions;",
      "        $0",
      "    }",
      "}"
    ],
    "description": "Compute shader with STAGE COMPUTE, numthreads, and RWStructuredBuffer"
  },
  "Geometry shader skeleton": {
    "prefix": "nsl-geometry",
    "body": [
      "STAGE GEOMETRY",
      "",
      "INPUT_LAYOUT",
      "{",
      "    Get(WORLD_POSITION)",
      "    Get(UV0)",
      "}",
      "",
      "OUTPUT_LAYOUT",
      "{",
      "    Add(CLIP_POSITION)",
      "    Add(WORLD_POSITION)",
      "    Add(UV0)",
      "}",
      "",
      "PROPERTY ${1:Geo}",
      "{",
      "    Buffer ${2:Params}",
      "    {",
      "        Get(MVP_MATRIX)",
      "    }",
      "}",
      "",
      "SHADER",
      "{",
      "    Mat4 mvp = ${1:Geo}.${2:Params}.MVP_MATRIX;",
      "",
      "    [maxvertexcount(3)]",
      "    [inputtopology(\"triangle\")]",
      "    [outputtopology(\"triangle\")]",
      "    void Main(STAGE_INPUT input[3], inout TriangleStream<STAGE_OUTPUT> stream)",
      "    {",
      "        for (Int i = 0; i < 3; i = i + 1)",
      "        {",
      "            STAGE_OUTPUT o;",
      "            o.CLIP_POSITION = Mul(mvp, Vec4(input[i].WORLD_POSITION, 1.0));",
      "            o.WORLD_POSITION = input[i].WORLD_POSITION;",
      "            o.UV0 = input[i].UV0;",
      "            Append(stream, o);",
      "        }",
      "        $0",
      "    }",
      "}"
    ],
    "description": "Geometry shader with stream Append"
  },
  "Hull shader skeleton": {
    "prefix": "nsl-hull",
    "body": [
      "STAGE HULL",
      "",
      "INPUT_LAYOUT",
      "{",
      "    Get(WORLD_POSITION)",
      "    Get(WORLD_NORMAL)",
      "    Get(UV0)",
      "}",
      "",
      "OUTPUT_LAYOUT",
      "{",
      "    Add(WORLD_POSITION)",
      "    Add(WORLD_NORMAL)",
      "    Add(UV0)",
      "}",
      "",
      "PROPERTY ${1:Hull}",
      "{",
      "    Buffer ${2:Params}",
      "    {",
      "        Add(tessFactor) : Float = 1.0",
      "    }",
      "}",
      "",
      "SHADER",
      "{",
      "    Float tess = ${1:Hull}.${2:Params}.tessFactor;",
      "",
      "    PATCH_CONSTANT_DATA PatchConstant(InputPatch<STAGE_INPUT, 3> patch)",
      "    {",
      "        PATCH_CONSTANT_DATA d;",
      "        d.EdgeFactors[0] = tess;",
      "        d.EdgeFactors[1] = tess;",
      "        d.EdgeFactors[2] = tess;",
      "        d.InsideFactor = tess;",
      "        return d;",
      "    }",
      "",
      "    [domain(\"tri\")]",
      "    [partitioning(\"fractional_odd\")]",
      "    [outputtopology(\"triangle_cw\")]",
      "    [outputcontrolpoints(3)]",
      "    STAGE_OUTPUT Main(InputPatch<STAGE_INPUT, 3> patch, UInt id : CONTROL_POINT_ID)",
      "    {",
      "        STAGE_OUTPUT o;",
      "        o.WORLD_POSITION = patch[id].WORLD_POSITION;",
      "        o.WORLD_NORMAL = patch[id].WORLD_NORMAL;",
      "        o.UV0 = patch[id].UV0;",
      "        return o;",
      "    }",
      "}"
    ],
    "description": "Hull shader with PatchConstant + Main"
  },
  "Domain shader skeleton": {
    "prefix": "nsl-domain",
    "body": [
      "STAGE DOMAIN",
      "",
      "INPUT_LAYOUT",
      "{",
      "    Get(WORLD_POSITION)",
      "    Get(WORLD_NORMAL)",
      "    Get(UV0)",
      "}",
      "",
      "OUTPUT_LAYOUT",
      "{",
      "    Add(CLIP_POSITION)",
      "    Add(WORLD_POSITION)",
      "    Add(WORLD_NORMAL)",
      "    Add(UV0)",
      "}",
      "",
      "PROPERTY ${1:Domain}",
      "{",
      "    Buffer ${2:Params}",
      "    {",
      "        Get(MVP_MATRIX)",
      "    }",
      "}",
      "",
      "SHADER",
      "{",
      "    Mat4 mvp = ${1:Domain}.${2:Params}.MVP_MATRIX;",
      "",
      "    [domain(\"tri\")]",
      "    STAGE_OUTPUT Main(",
      "        PATCH_CONSTANT_DATA constants,",
      "        Vec3 bary : DOMAIN_LOCATION,",
      "        OutputPatch<STAGE_INPUT, 3> patch)",
      "    {",
      "        STAGE_OUTPUT o;",
      "        Vec3 wp = patch[0].WORLD_POSITION * bary.x",
      "                + patch[1].WORLD_POSITION * bary.y",
      "                + patch[2].WORLD_POSITION * bary.z;",
      "        o.CLIP_POSITION = Mul(mvp, Vec4(wp, 1.0));",
      "        o.WORLD_POSITION = wp;",
      "        o.WORLD_NORMAL = Normalize(",
      "            patch[0].WORLD_NORMAL * bary.x +",
      "            patch[1].WORLD_NORMAL * bary.y +",
      "            patch[2].WORLD_NORMAL * bary.z);",
      "        o.UV0 = patch[0].UV0 * bary.x + patch[1].UV0 * bary.y + patch[2].UV0 * bary.z;",
      "        return o;",
      "    }",
      "}"
    ],
    "description": "Domain shader with PATCH_CONSTANT_DATA + OutputPatch"
  },
  "NVS shadow evaluation (PCF 3x3)": {
    "prefix": "nsl-nvs-eval",
    "body": [
      "Float shadowFactor = NVSSampleLightShadowPCF3x3(",
      "    ${1:viewBase},",
      "    ${2:viewCount},",
      "    ${3:input.WORLD_POSITION},",
      "    ${4:N},",
      "    ${5:1.5},",
      "    ${6:1.0}",
      ");",
      "$0"
    ],
    "description": "Northstar Virtual Shadows 3x3 PCF evaluation via NorthstarLibrary/NVSFiltering.nsl"
  },
