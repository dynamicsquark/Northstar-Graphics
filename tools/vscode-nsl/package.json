{
  "name": "nsl",
  "displayName": "Northstar Shader Language (NSL)",
  "description": "Syntax highlighting, language configuration, code snippets, and library module support for Northstar Shader Language (.nsl)",
  "version": "3.2.0",
  "publisher": "northstar",
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets"
  ],
  "keywords": [
    "nsl",
    "northstar",
    "shader",
    "hlsl",
    "graphics",
    "stage",
    "nvs",
    "nvg",
    "library"
  ],
  "contributes": {
    "languages": [
      {
        "id": "nsl",
        "aliases": [
          "NSL",
          "Northstar Shader Language"
        ],
        "extensions": [
          ".nsl"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/nsl.svg",
          "dark": "./icons/nsl.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "nsl",
        "scopeName": "source.nsl",
        "path": "./syntaxes/nsl.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "nsl",
        "path": "./snippets/nsl.json"
      }
    ],
    "configurationDefaults": {
      "[nsl]": {
        "editor.tabSize": 4,
        "editor.insertSpaces": true,
        "editor.suggest.insertMode": "replace",
        "editor.quickSuggestions": {
          "other": true,
          "comments": false,
          "strings": false
        }
      }
    }
  }
}
