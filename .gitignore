# Build & Output Directories
/[Bb]uild/
/[Oo]ut/
/[Bb]in/
/[Ll]ib/
**/[Bb]uild/
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
Makefile
*.ninja
.ninja_*

# Compiled Northstar Shader Containers & Shader Caches (Generated by build.bat)
*.nsc
*.nsdc

# IDE & User Configuration
.vs/
.vscode/
.idea/
*.sln
*.slnx
*.vcxproj*
*.user
*.suo
*.userosscache
*.sln.docstates
CMakeUserPresets.json
CMakeSettings.json

# Compiler & Linker Intermediates
*.obj
*.o
*.pdb
*.ilk
*.ipdb
*.iobj
*.pch
*.idb
*.tlog
*.log
*.lastbuildstate
*.exp

# Diagnostics & GPU Captures
*.dmp
*.pix3

# Keep Vendored Third-Party Libraries & Runtime Binaries
!thirdparty/assimp/lib/*.lib
!thirdparty/assimp/lib/*.def
!thirdparty/assimp/bin/*.dll
