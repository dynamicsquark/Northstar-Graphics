// =====================================================================
//  StandardLitInstancedVS.nsl
//  Northstar Graphics — Built-in GPU-Instanced Standard Lit Vertex Shader
//
//  Implements ShaderVariant::INSTANCED using Get(INSTANCE_WORLD_MATRIX)
//  and exact cofactor adjugate normal transformation for non-uniform
//  and negative-determinant (mirrored) instance transforms.
// =====================================================================

STAGE VERTEX

INPUT_LAYOUT
{
    Get(VERTEX_POSITION)
    Get(VERTEX_NORMAL)
    Get(VERTEX_TANGENT)
    Get(VERTEX_BITANGENT)
    Get(VERTEX_UV0)
    Get(VERTEX_UV1)
    Get(VERTEX_COLOR)
    Get(INSTANCE_ID)
}

OUTPUT_LAYOUT
{
    Add(CLIP_POSITION)
    Add(WORLD_POSITION)
    Add(WORLD_NORMAL)
    Add(TANGENT)
    Add(BITANGENT)
    Add(UV0)
    Add(UV1)
    Add(COLOR)
}

PROPERTY Transforms
{
    Buffer Matrices
    {
        Get(VP_MATRIX)
    }
    StructuredBuffer Instances
    {
        Get(INSTANCE_WORLD_MATRIX)
    }
}

SHADER
{
    STAGE_OUTPUT Main(STAGE_INPUT input)
    {
        STAGE_OUTPUT o;

        Mat4 instWorld = Transforms.Instances[input.INSTANCE_ID].INSTANCE_WORLD_MATRIX;
        Vec4 wp        = Mul(instWorld, Vec4(input.VERTEX_POSITION, 1.0));

        Vec3  c0       = Mul(instWorld, Vec4(1.0, 0.0, 0.0, 0.0)).xyz;
        Vec3  c1       = Mul(instWorld, Vec4(0.0, 1.0, 0.0, 0.0)).xyz;
        Vec3  c2       = Mul(instWorld, Vec4(0.0, 0.0, 1.0, 0.0)).xyz;
        Vec3  c1xc2    = Cross(c1, c2);
        Vec3  c2xc0    = Cross(c2, c0);
        Vec3  c0xc1    = Cross(c0, c1);
        Float detSign  = (Dot(c0, c1xc2) < 0.0) ? -1.0 : 1.0;

        Vec3 worldNrm  = Normalize((c1xc2 * input.VERTEX_NORMAL.x + c2xc0 * input.VERTEX_NORMAL.y + c0xc1 * input.VERTEX_NORMAL.z) * detSign);
        Vec3 rawTan    = Mul(instWorld, Vec4(input.VERTEX_TANGENT, 0.0)).xyz;
        Vec3 worldTan  = Normalize(rawTan - worldNrm * Dot(rawTan, worldNrm));
        Vec3 worldBit  = Normalize(Mul(instWorld, Vec4(input.VERTEX_BITANGENT, 0.0)).xyz);

        o.CLIP_POSITION  = Mul(Transforms.Matrices.VP_MATRIX, wp);
        o.WORLD_POSITION = wp.xyz;
        o.WORLD_NORMAL   = worldNrm;
        o.TANGENT        = worldTan;
        o.BITANGENT      = worldBit;
        o.UV0            = input.VERTEX_UV0;
        o.UV1            = input.VERTEX_UV1;
        o.COLOR          = input.VERTEX_COLOR;

        return o;
    }
}
