// =====================================================================
//  StandardLitShadowInstancedSkinnedVS.nsl
//  Northstar Graphics — Unified IA + NVG Instanced Skinned NVS Shadow VS
//
//  Implements ShaderVariant::INSTANCED_SKINNED for PassType::SHADOW across
//  GeometryMode::STANDARD and GeometryMode::VIRTUALIZED from one ShaderSet:
//    - STANDARD    : Tier-1 GPU Instancing + 4-bone LBS skinning + NVS bias
//    - VIRTUALIZED : Live PagePool skinned cluster decode + NVS shadow view
// =====================================================================

STAGE VERTEX

LIBRARY_DECLARATION
{
    Add("NorthstarLibrary/VirtualGeometry/VirtualGeometry.nsl")
}

INPUT_LAYOUT
{
    Get(VERTEX_POSITION)
    Get(VERTEX_NORMAL)
    Get(VERTEX_UV0)
    Get(VERTEX_BONE_INDICES)
    Get(VERTEX_BONE_WEIGHTS)
    Get(VERTEX_ID)
    Get(INSTANCE_ID)
}

OUTPUT_LAYOUT
{
    Add(CLIP_POSITION)
    Add(UV0)
    Add(RENDER_TARGET_ARRAY_INDEX)
}

PROPERTY Transforms
{
    Buffer Matrices
    {
        Get(VP_MATRIX)
        Get(GEOMETRY_MODE)
        Get(NVS_PHYSICAL_PAGE_INDEX)
        Get(NVS_DEPTH_BIAS_NDC)
        Get(NVS_NORMAL_BIAS_WORLD)
    }
    StructuredBuffer Instances
    {
        Get(INSTANCE_WORLD_MATRIX)
        Get(INSTANCE_BONE_OFFSET)
        Get(INSTANCE_BONE_COUNT)
    }
}

SHADER
{
    STAGE_OUTPUT Main(STAGE_INPUT input)
    {
        STAGE_OUTPUT o;

        UInt geomMode   = Transforms.Matrices.GEOMETRY_MODE;
        Bool useNvg     = (geomMode == 1u) && NVGIsAvailable() && NVGHasActiveCluster(input.INSTANCE_ID);
        Bool nvgHandled = false;

        o.CLIP_POSITION             = Vec4(0.0, 0.0, 0.0, 1.0);
        o.UV0                       = input.VERTEX_UV0;
        o.RENDER_TARGET_ARRAY_INDEX = 0u;

        if (useNvg)
        {
            NVGVisibleCluster vc  = NVGLoadVisibleCluster(input.INSTANCE_ID);
            NVGClusterHeader  hdr = NVGDecodeClusterHeader(vc);
            if (input.VERTEX_ID < hdr.vertexCount)
            {
                NVGDecodedVertex v = NVGDecodeLocalVertex(hdr, input.VERTEX_ID);
                NVGApplyVertexSkinning(vc.bonePaletteOffset, vc.boneCount, v);

                Mat4              world    = NVGGetObjectWorldMatrix(vc.objectSlot);
                Vec3              worldPos = NVGTransformPosition(world, v.position);
                Vec3              worldNrm = NVGTransformNormal(world, v.normal);
                NVGShadowPageView pageView = NVGLoadShadowPageView(vc.shadowPageViewIndex);
                if (pageView.physicalPageSlice != NVGInvalidIndex())
                {
                    o.CLIP_POSITION             = NVGProjectToShadowPage(pageView, worldPos, worldNrm);
                    o.UV0                       = v.uv0;
                    o.RENDER_TARGET_ARRAY_INDEX = pageView.physicalPageSlice;
                    nvgHandled                  = true;
                }
            }
        }

        if (!nvgHandled)
        {
            UInt  instIdx    = useNvg ? 0u : input.INSTANCE_ID;
            Mat4  instWorld  = Transforms.Instances[instIdx].INSTANCE_WORLD_MATRIX;
            UInt  bOff       = Transforms.Instances[instIdx].INSTANCE_BONE_OFFSET;
            UInt  bCnt       = Transforms.Instances[instIdx].INSTANCE_BONE_COUNT;
            Float depthBias  = Transforms.Matrices.NVS_DEPTH_BIAS_NDC;
            Float normalBias = Transforms.Matrices.NVS_NORMAL_BIAS_WORLD;

            Vec3 localPos = input.VERTEX_POSITION;
            Vec3 localNrm = input.VERTEX_NORMAL;
            NVGApplyLinearBlendSkinningPosNormal(
                bOff,
                bCnt,
                input.VERTEX_BONE_INDICES,
                input.VERTEX_BONE_WEIGHTS,
                localPos,
                localNrm);

            Vec3 worldPos = NVGTransformPosition(instWorld, localPos);
            if (normalBias != 0.0)
            {
                Vec3 worldNrm = NVGTransformNormal(instWorld, localNrm);
                worldPos      = worldPos - worldNrm * normalBias;
            }

            Vec4 clipPos = Mul(Transforms.Matrices.VP_MATRIX, Vec4(worldPos, 1.0));
            if (depthBias != 0.0 && clipPos.w > 0.0)
            {
                clipPos.z = clipPos.z + (depthBias * clipPos.w);
            }

            o.CLIP_POSITION             = clipPos;
            o.UV0                       = input.VERTEX_UV0;
            o.RENDER_TARGET_ARRAY_INDEX = Transforms.Matrices.NVS_PHYSICAL_PAGE_INDEX;
        }

        return o;
    }
}
