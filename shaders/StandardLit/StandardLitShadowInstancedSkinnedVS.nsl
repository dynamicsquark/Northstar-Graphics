// =====================================================================
//  StandardLitShadowInstancedSkinnedVS.nsl
//  Northstar Graphics — Built-in GPU-Instanced Skinned NVS Shadow Caster VS
// =====================================================================

STAGE VERTEX

INPUT_LAYOUT
{
    Get(VERTEX_POSITION)
    Get(VERTEX_NORMAL)
    Get(VERTEX_UV0)
    Get(VERTEX_BONE_INDICES)
    Get(VERTEX_BONE_WEIGHTS)
    Get(INSTANCE_ID)
}

OUTPUT_LAYOUT
{
    Add(CLIP_POSITION)
    Add(UV0)
    Add(RENDER_TARGET_ARRAY_INDEX)
}

PROPERTY Transforms
{
    Buffer Matrices
    {
        Get(VP_MATRIX)
        Get(NVS_PHYSICAL_PAGE_INDEX)
        Get(NVS_DEPTH_BIAS_NDC)
        Get(NVS_NORMAL_BIAS_WORLD)
    }
    StructuredBuffer Instances
    {
        Get(INSTANCE_WORLD_MATRIX)
        Get(INSTANCE_BONE_OFFSET)
        Get(INSTANCE_BONE_COUNT)
    }
}

PROPERTY Skeleton
{
    StructuredBuffer BonePalette
    {
        Get(GLOBAL_BONE_MATRIX)
    }
}

SHADER
{
    STAGE_OUTPUT Main(STAGE_INPUT input)
    {
        STAGE_OUTPUT o;

        Mat4  instWorld  = Transforms.Instances[input.INSTANCE_ID].INSTANCE_WORLD_MATRIX;
        UInt  bOff       = Transforms.Instances[input.INSTANCE_ID].INSTANCE_BONE_OFFSET;
        UInt  bCnt       = Transforms.Instances[input.INSTANCE_ID].INSTANCE_BONE_COUNT;
        Float depthBias  = Transforms.Matrices.NVS_DEPTH_BIAS_NDC;
        Float normalBias = Transforms.Matrices.NVS_NORMAL_BIAS_WORLD;

        Vec3 localPos = input.VERTEX_POSITION;
        Vec3 localNrm = input.VERTEX_NORMAL;

        if (bCnt > 0u)
        {
            Vec4  rawW = input.VERTEX_BONE_WEIGHTS;
            Float wSum = rawW.x + rawW.y + rawW.z + rawW.w;
            Vec4  w    = (wSum > 0.0001) ? (rawW / wSum) : Vec4(1.0, 0.0, 0.0, 0.0);

            UInt  maxIdx = bCnt - 1u;
            UInt4 idx    = input.VERTEX_BONE_INDICES;
            Mat4  bone0  = Skeleton.BonePalette[bOff + Min(idx.x, maxIdx)].GLOBAL_BONE_MATRIX;
            Mat4  bone1  = Skeleton.BonePalette[bOff + Min(idx.y, maxIdx)].GLOBAL_BONE_MATRIX;
            Mat4  bone2  = Skeleton.BonePalette[bOff + Min(idx.z, maxIdx)].GLOBAL_BONE_MATRIX;
            Mat4  bone3  = Skeleton.BonePalette[bOff + Min(idx.w, maxIdx)].GLOBAL_BONE_MATRIX;

            Vec4 p4  = Vec4(input.VERTEX_POSITION, 1.0);
            localPos = Mul(bone0, p4).xyz * w.x + Mul(bone1, p4).xyz * w.y + Mul(bone2, p4).xyz * w.z + Mul(bone3, p4).xyz * w.w;

            Vec4 n4  = Vec4(input.VERTEX_NORMAL, 0.0);
            localNrm = Mul(bone0, n4).xyz * w.x + Mul(bone1, n4).xyz * w.y + Mul(bone2, n4).xyz * w.z + Mul(bone3, n4).xyz * w.w;
        }

        Vec4 worldPos = Mul(instWorld, Vec4(localPos, 1.0));
        if (normalBias != 0.0)
        {
            Vec3 c0       = Mul(instWorld, Vec4(1.0, 0.0, 0.0, 0.0)).xyz;
            Vec3 c1       = Mul(instWorld, Vec4(0.0, 1.0, 0.0, 0.0)).xyz;
            Vec3 c2       = Mul(instWorld, Vec4(0.0, 0.0, 1.0, 0.0)).xyz;
            Vec3 c1xc2    = Cross(c1, c2);
            Vec3 nrmWorld = (c1xc2 * localNrm.x) +
                            (Cross(c2, c0) * localNrm.y) +
                            (Cross(c0, c1) * localNrm.z);
            if (Dot(c0, c1xc2) < 0.0)
            {
                nrmWorld = -nrmWorld;
            }
            Float nLenSq = Dot(nrmWorld, nrmWorld);
            if (nLenSq > 0.000001)
            {
                nrmWorld     = nrmWorld * Rsqrt(nLenSq);
                worldPos.xyz = worldPos.xyz - nrmWorld * normalBias;
            }
        }

        Vec4 clipPos = Mul(Transforms.Matrices.VP_MATRIX, worldPos);
        if (depthBias != 0.0 && clipPos.w > 0.0)
        {
            clipPos.z = clipPos.z + (depthBias * clipPos.w);
        }

        o.CLIP_POSITION             = clipPos;
        o.UV0                       = input.VERTEX_UV0;
        o.RENDER_TARGET_ARRAY_INDEX = Transforms.Matrices.NVS_PHYSICAL_PAGE_INDEX;
        return o;
    }
}
