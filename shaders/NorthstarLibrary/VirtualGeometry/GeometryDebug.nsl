// =====================================================================
//  GeometryDebug.nsl — Northstar NSL Standard Library: Virtual Geometry Debug Visualization
//
//  Opt-in developer library for deterministic false-color NVG diagnostics
//  driven by Get(NVG_DEBUG_MODE):
//    0 : NONE (returns developer's unmodified color)
//    1 : CLUSTER_ID
//    2 : LOD_LEVEL
//    3 : VIRTUAL_PAGE
//    4 : PHYSICAL_PAGE
//    5 : GEOMETRIC_ERROR
//    6 : RESIDENCY_FALLBACK
//    7 : NORMAL_CONE
//
//  Usage in any developer Vertex or Pixel Shader:
//    LIBRARY_DECLARATION { Add("NorthstarLibrary/VirtualGeometry/GeometryDebug.nsl") }
//    // In Pixel Shader (per-cluster IA / indexed-pull):
//    finalColor = NVGApplyPixelDebugColor(finalColor, worldNormal);
//    // Or in Vertex-Pulling Vertex Shader:
//    outColor = NVGApplyDebugColor(v.color.rgb, input.INSTANCE_ID, worldNormal);
// =====================================================================

LIBRARY_DECLARATION
{
    Add("NorthstarLibrary/VirtualGeometry/GeometryCluster.nsl")
}

LIBRARY
{
    Bool NVGIsDebugModeActive()
    {
        return NVGGetDebugMode() != 0u;
    }

    Vec3 NVGHashColorUInt(UInt seed)
    {
        UInt h = seed * 747796405u + 2891336453u;
        h = ((h >> ((h >> 28u) + 4u)) ^ h) * 277803737u;
        h = (h >> 22u) ^ h;
        Float r = Float(h & 255u) / 255.0;
        Float g = Float((h >> 8u) & 255u) / 255.0;
        Float b = Float((h >> 16u) & 255u) / 255.0;
        return Vec3(0.22 + r * 0.78, 0.22 + g * 0.78, 0.22 + b * 0.78);
    }

    Vec3 NVGLodLevelColor(UInt lodLevel)
    {
        if (lodLevel == 0u) return Vec3(0.10, 0.85, 0.25); // LOD 0: Vivid Green
        if (lodLevel == 1u) return Vec3(0.15, 0.75, 0.90); // LOD 1: Cyan
        if (lodLevel == 2u) return Vec3(0.20, 0.40, 0.95); // LOD 2: Blue
        if (lodLevel == 3u) return Vec3(0.85, 0.80, 0.15); // LOD 3: Yellow
        if (lodLevel == 4u) return Vec3(0.95, 0.50, 0.10); // LOD 4: Orange
        if (lodLevel == 5u) return Vec3(0.92, 0.18, 0.18); // LOD 5: Red
        return Vec3(0.85, 0.20, 0.85);                     // LOD 6+: Magenta
    }

    Vec3 NVGComputeDebugColor(NVGVisibleCluster vc, Vec3 worldNormal)
    {
        UInt mode = NVGGetDebugMode();
        if (mode == 1u)
        {
            return NVGHashColorUInt(vc.clusterId + 1u);
        }
        if (mode == 2u)
        {
            return NVGLodLevelColor(vc.lodLevel);
        }
        if (mode == 3u)
        {
            return NVGHashColorUInt(vc.virtualPageId * 13u + 7u);
        }
        if (mode == 4u)
        {
            return NVGHashColorUInt(vc.physicalPageIndex * 29u + 3u);
        }
        if (mode == 5u)
        {
            Float maxErr = Max(NVGResources.Params.NVG_MAX_SCREEN_ERROR_PX, 0.05);
            Float ratio  = vc.geometricError / maxErr;
            Float t      = Clamp(ratio * 0.72, 0.0, 1.0);
            return Vec3(t, 1.0 - Abs(t * 2.0 - 1.0), 1.0 - t);
        }
        if (mode == 6u)
        {
            Bool isFallback = ((vc.flags & 1u) != 0u);
            return isFallback ? Vec3(1.0, 0.15, 0.15) : Vec3(0.15, 0.85, 0.35);
        }
        if (mode == 7u)
        {
            return worldNormal * 0.5 + Vec3(0.5, 0.5, 0.5);
        }
        return Vec3(1.0, 1.0, 1.0);
    }

    // Opt-in resolver: returns true and populates outDebugColor ONLY when NVG_DEBUG_MODE != 0
    // and the current draw belongs to an active virtualized cluster; otherwise returns false
    // without altering standard or non-debug draws.
    Bool NVGTryResolveDebugColor(UInt instanceId, Vec3 worldNormal, out Vec3 outDebugColor)
    {
        if (NVGGetDebugMode() == 0u || !NVGIsAvailable() || !NVGHasActiveCluster(instanceId))
        {
            outDebugColor = Vec3(0.0, 0.0, 0.0);
            return false;
        }
        Float nLenSq = Dot(worldNormal, worldNormal);
        Vec3  safeN  = (nLenSq > 0.0001) ? (worldNormal * Rsqrt(nLenSq)) : Vec3(0.0, 1.0, 0.0);
        NVGVisibleCluster vc = NVGLoadVisibleCluster(instanceId);
        outDebugColor = NVGComputeDebugColor(vc, safeN);
        return true;
    }

    // Opt-in unshaded false-color helper for Vertex-Pulling or Instanced stages (pass input.INSTANCE_ID)
    Vec3 NVGApplyDebugColor(Vec3 baseColor, UInt instanceId, Vec3 worldNormal)
    {
        Vec3 dbgColor = Vec3(0.0, 0.0, 0.0);
        if (NVGTryResolveDebugColor(instanceId, worldNormal, dbgColor))
        {
            return dbgColor;
        }
        return baseColor;
    }

    // Opt-in relief-shaded false-color helper for Vertex-Pulling or Instanced stages
    Vec3 NVGApplyDebugShadedColor(Vec3 baseColor, UInt instanceId, Vec3 worldNormal)
    {
        Vec3 dbgColor = Vec3(0.0, 0.0, 0.0);
        if (NVGTryResolveDebugColor(instanceId, worldNormal, dbgColor))
        {
            if (NVGGetDebugMode() == 7u)
            {
                return dbgColor;
            }
            Float nLenSq = Dot(worldNormal, worldNormal);
            Vec3  safeN  = (nLenSq > 0.0001) ? (worldNormal * Rsqrt(nLenSq)) : Vec3(0.0, 1.0, 0.0);
            Float ndl    = 0.32 + 0.68 * Max(Dot(safeN, Normalize(Vec3(0.45, 0.80, -0.40))), 0.0);
            return Saturate(dbgColor * ndl);
        }
        return baseColor;
    }

    // Opt-in single-call Pixel Shader helpers for per-cluster IA / Indexed-Pull draws (instanceId = 0)
    Vec3 NVGApplyPixelDebugColor(Vec3 baseColor, Vec3 worldNormal)
    {
        return NVGApplyDebugColor(baseColor, 0u, worldNormal);
    }

    Vec3 NVGApplyPixelDebugShadedColor(Vec3 baseColor, Vec3 worldNormal)
    {
        return NVGApplyDebugShadedColor(baseColor, 0u, worldNormal);
    }
}
