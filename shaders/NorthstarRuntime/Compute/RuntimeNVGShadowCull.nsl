// =====================================================================
//  RuntimeNVGShadowCull.nsl — NorthstarRuntime Internal Compute
//  Northstar Virtual Geometry (NVG) x Northstar Virtual Shadows (NVS)
//  Independent GPU Shadow Caster Culling, Shadow-Texel LOD Selection,
//  Thin-Geometry Silhouette Preservation & Residency-Aware Shadow Fallback
//
//  Dispatch Modes:
//    Mode 0 (PREPARE_SHADOW_VIEWS):
//      Resets shadow queues & bucket counts, reads NVS active dirty page count,
//      and populates OutShadowPageViews[0 .. activePageCount-1].
//    Mode 1 (CULL_SHADOW_CASTERS):
//      Scans InGPUSceneObjects for active GPU_SCENE_OBJ_VIRTUAL_GEOMETRY +
//      GPU_SCENE_OBJ_CAST_SHADOW casters (NEVER camera-frustum-culled!), tests
//      world AABB against every active NVS shadow page volume, and enqueues
//      overlapping (objectSlot, rootNode, shadowBucket, shadowPageViewIdx).
//    Mode 2 (TRAVERSE_SHADOW_BVH):
//      Traverses BVH nodes per (objectSlot, shadowPageViewIdx), clipping node
//      AABB against page clip volume and emitting child nodes or leaf clusters.
//    Mode 3 (EVALUATE_SHADOW_CLUSTERS):
//      Evaluates independent NVS shadow-texel LOD cut:
//        shadowErrTexels = (E_world / page.texelWorldSize) * (1 + thinBoost * thinMetric)
//      Independent of Camera Geometry LOD! Enforces crack-free residency
//      fallback + GPU page faulting, emits shadow NVGVisibleClusterGPUData,
//      and records independent shadowLODHistogram & shadowLODSum telemetry.
// =====================================================================

STAGE COMPUTE

PROPERTY NVGShadowCullParams {
    Buffer Config {
        Add(dispatchMode)           : UInt  = 0
        Add(sceneSlotCount)         : UInt  = 0
        Add(meshTableCount)         : UInt  = 0
