    RWStructuredBuffer OutNodeQueue {
        Add(objectSlotIndex) : UInt
        Add(nodeOrClusterId) : UInt
        Add(drawBucketHint)  : UInt
        Add(auxData)         : UInt
    }
    RWStructuredBuffer OutCandidateClusters {
        Add(objectSlotIndex) : UInt
        Add(nodeOrClusterId) : UInt
        Add(drawBucketHint)  : UInt
        Add(auxData)         : UInt
